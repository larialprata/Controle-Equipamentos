# Banco de dados (troque pelos valores de cada ambiente)
# Produção: configure DATABASE_URL e DIRECT_URL nas variáveis de ambiente do hosting
#
# Desenvolvimento local com Docker (docker compose up -d):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/app_dev"
#
DATABASE_URL="postgresql://usuario:senha@host:porta/banco?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@host:porta/banco"

# JWT (obrigatório — a API não inicia sem JWT_SECRET)
JWT_SECRET=alterar-em-producao
JWT_EXPIRES_IN=7d

# Swagger: em produção fica desligado até definir SWAGGER_ENABLED=true
# SWAGGER_ENABLED=true

# Admin (opcional)
ADMIN_EMAIL=email@email.com
ADMIN_PASSWORD=senha-segura
ADMIN_CPF=00000000000

# Leitura do horímetro por foto (Gemini Vision) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
